# Template for the local .env file (copy to `.env`, which git ignores).
# Only secrets and machine-specific paths live here; every other setting is in
# config/sivin.yaml (portal URL, folder and tab names, timeouts, download directory).
# In GitHub Actions the same two credentials are repository Secrets with the same names.

# --- Credentials for lemon.e-service.cz (required) ---------------------------
SIVIN_USER=
SIVIN_PASSWORD=

# --- Optional: browser location (leave empty to auto-detect) -----------------
# Chrome/Chromium executable, e.g. /usr/bin/chromium or
# C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_BINARY=
# Directory that contains the chromedriver executable (GitHub runners set this).
CHROMEWEBDRIVER=
