{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Placement": {
      "additionalProperties": false,
      "description": "One placement of a sensor: where it stood from one instant to another.",
      "properties": {
        "from": {
          "description": "Deployment instant, ISO 8601 with offset; stored in UTC.",
          "format": "date-time",
          "title": "From",
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End of the placement (exclusive), ISO 8601 in UTC; null while it lasts.",
          "title": "To"
        },
        "lon": {
          "description": "Longitude in degrees east (WGS 84).",
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Lon",
          "type": "number"
        },
        "lat": {
          "description": "Latitude in degrees north (WGS 84).",
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Lat",
          "type": "number"
        },
        "elevation_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Elevation in metres above sea level; null if unknown.",
          "title": "Elevation M"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-text note (no unit); null if none.",
          "title": "Note"
        }
      },
      "required": [
        "from",
        "lon",
        "lat"
      ],
      "title": "Placement",
      "type": "object"
    },
    "PointGeometry": {
      "additionalProperties": false,
      "description": "GeoJSON Point of the sensor's last placement.",
      "properties": {
        "type": {
          "const": "Point",
          "description": "GeoJSON geometry type.",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "description": "[longitude, latitude] in degrees (WGS 84) of the last placement.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "PointGeometry",
      "type": "object"
    },
    "Sensor": {
      "additionalProperties": false,
      "description": "A sensor of the registry with its placement history.",
      "properties": {
        "id": {
          "description": "Canonical id: the 8-digit device serial number.",
          "pattern": "^[0-9]{8}$",
          "title": "Id",
          "type": "string"
        },
        "portal_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Device name in the provider's portal, e.g. '8615620 77678271'; null if unknown.",
          "title": "Portal Name"
        },
        "label": {
          "description": "Human-readable name, e.g. '77678271 (VUT)'.",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "site": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vineyard or site name; null if unknown.",
          "title": "Site"
        },
        "variety": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Grape variety at the sensor; null if unknown.",
          "title": "Variety"
        },
        "status": {
          "description": "Life-cycle state: active, inactive or retired.",
          "enum": [
            "active",
            "inactive",
            "retired"
          ],
          "title": "Status",
          "type": "string"
        },
        "placements": {
          "description": "Placement history in time order; only the last may be open.",
          "items": {
            "$ref": "#/$defs/Placement"
          },
          "minItems": 1,
          "title": "Placements",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free text; null if none.",
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "label",
        "status",
        "placements"
      ],
      "title": "Sensor",
      "type": "object"
    },
    "SensorFeature": {
      "additionalProperties": false,
      "description": "GeoJSON Feature of one sensor.",
      "properties": {
        "type": {
          "const": "Feature",
          "description": "GeoJSON object type.",
          "title": "Type",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/PointGeometry",
          "description": "Position of the last placement."
        },
        "properties": {
          "$ref": "#/$defs/Sensor",
          "description": "The sensor and its placement history."
        }
      },
      "required": [
        "type",
        "geometry",
        "properties"
      ],
      "title": "SensorFeature",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "sensors/sensors.geojson: one GeoJSON Point feature per sensor with its placement history (MIGRATION_PLAN §2.4). Generated from sivin.registry; do not edit by hand.",
  "properties": {
    "type": {
      "const": "FeatureCollection",
      "description": "GeoJSON object type.",
      "title": "Type",
      "type": "string"
    },
    "features": {
      "description": "One feature per sensor.",
      "items": {
        "$ref": "#/$defs/SensorFeature"
      },
      "title": "Features",
      "type": "array"
    }
  },
  "required": [
    "type",
    "features"
  ],
  "title": "SIVIN sensor registry",
  "type": "object"
}
