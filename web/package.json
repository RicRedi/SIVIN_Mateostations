{
  "name": "sivin-web",
  "version": "0.1.0",
  "private": true,
  "description": "Static map portal for the SIVIN vineyard weather sensors",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
